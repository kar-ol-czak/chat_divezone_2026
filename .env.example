# Aiven PostgreSQL (pgvector)
PG_HOST=<AIVEN_HOST_REDACTED>
PG_PORT=22367
PG_DATABASE=defaultdb
PG_USER=avnadmin
PG_PASSWORD=
PG_SSLMODE=require

# PrestaShop MySQL (read-only dla pipeline)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_PREFIX=pr_

# OpenAI API (embeddingi + opcjonalnie czat)
OPENAI_API_KEY=

# Claude API (opcjonalnie czat)
ANTHROPIC_API_KEY=

# Max tokenów odpowiedzi providera (kalibracja T-022b 2026-05-26).
# 2500 = reasoning ~150-250 + content nurkowy multi-product ~2000 + zapas.
# Nie używać <300 dla gpt-5-mini (reasoning zjada cały budżet → content_len=0, finish=length).
# Nie używać >3000 — marnowanie budżetu, cache OpenAI i tak best-effort (H5, hipoteza
# „max blokuje cache" obalona empirycznie macierzą w t022b_max_tokens_matrix.php).
AI_MAX_TOKENS=2500

# =========================================================================
# DWA OSOBNE SEKRETY KANALOW (ADR-068, rozdzielenie zaufania klient/serwer)
# UWAGA: NIE myl ich przy wprowadzaniu. Karol pomylil w T-032 — od T-035
# zostawiamy jasny opis kazdego.
# -------------------------------------------------------------------------
# DIVECHAT_SECRET — KANAL KLIENCKI (klient czat -> backend, T-006a):
#   Uzywany przez HmacVerifier do weryfikacji tokena z modulu PS hookujacego
#   widget czatu (X-DiveChat-Token + X-DiveChat-Customer + X-DiveChat-Time,
#   payload customer_id:timestamp). Sekret dzielony miedzy:
#     - thin PS module hookujacy widget czatu na sklepie
#     - backend /api/chat
DIVECHAT_SECRET=

# DIVECHAT_SERVER_SECRET — KANAL SERWEROWY (modul admina PS -> backend, T-032):
#   Uzywany przez ServerHmacVerifier do weryfikacji podpisu modulu admina
#   divezone_chat wywolujacego /api/admin/whoami i /api/admin/recommendations
#   (X-DiveChat-Server-Token/-Employee/-Time, payload employee_id:timestamp).
#   64-hex-char generowany przez `openssl rand -hex 32`.
#   Wartosc IDENTYCZNA z Configuration::get('DIVEZONE_CHAT_SERVER_SECRET') w
#   panelu PS modulu (Moduly -> DiveZone Chat -> Konfiguruj).
#   ROZNY od DIVECHAT_SECRET — drugi kanal, druga tozsamosc (pracownik, NIE klient).
DIVECHAT_SERVER_SECRET=
# =========================================================================
